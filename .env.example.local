# Copy this file to .env.local and fill in real values.

# --- Database (Neon Postgres) ---------------------------------------------
# Get this from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Encryption keys -------------------------------------------------------
# 32-byte hex (64 chars). Generate each with: openssl rand -hex 32
# ENCRYPTION_KEY encrypts saved passwords (AES-256-GCM).
# HMAC_KEY is used to fingerprint passwords so we can warn about reuse
# without ever storing plaintext. Keep them DIFFERENT.
ENCRYPTION_KEY=
HMAC_KEY=

# --- Clerk (https://dashboard.clerk.com) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional overrides — sensible defaults already match these:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/vault
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/vault

# Clerk webhook signing secret (Dashboard → Webhooks → "Signing Secret").
# Only required if you set up the /api/webhooks/clerk endpoint.
CLERK_WEBHOOK_SECRET=
